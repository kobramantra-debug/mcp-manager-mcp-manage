# MCP Manager - Environment Variables
# Copy this file to .env and fill in your values

# Master password for Fernet encryption of stored tokens
# If not set, tokens are stored in plaintext (not recommended for production)
MCP_MANAGER_MASTER_PASSWORD=

# Default harness to manage (opencode, claude-desktop, cursor, windsurf, cline, zed, continue)
# Can be changed at runtime via switch_harness tool
MCP_HARNESS=opencode

# Path to the MCP config file to manage
# If not set, uses the default path for the active harness
# MCP_CONFIG_PATH=/path/to/your/config.json
